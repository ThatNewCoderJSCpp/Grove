{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Bark",
    "scopeName": "source.bark",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#variable-declaration"
        },
        {
            "include": "#at-rule"
        },
        {
            "include": "#block"
        },
        {
            "include": "#selectors"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.bark",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.bark",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "variable-declaration": {
            "begin": "(\\$[A-Za-z_][\\w-]*)\\s*(=|:)",
            "beginCaptures": {
                "1": {
                    "name": "variable.other.declaration.bark"
                },
                "2": {
                    "name": "keyword.operator.assignment.bark"
                }
            },
            "end": "(;)|(?=\\})",
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.bark"
                }
            },
            "patterns": [
                {
                    "include": "#values"
                }
            ]
        },
        "at-rule": {
            "begin": "(@[A-Za-z_][\\w-]*)",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.at-rule.bark"
                }
            },
            "end": "(;)|$",
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.bark"
                }
            },
            "patterns": [
                {
                    "include": "#strings"
                }
            ]
        },
        "block": {
            "begin": "\\{",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.block.begin.bark"
                }
            },
            "end": "\\}",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.block.end.bark"
                }
            },
            "patterns": [
                {
                    "include": "#block-body"
                }
            ]
        },
        "block-body": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#variable-declaration"
                },
                {
                    "include": "#declaration"
                },
                {
                    "include": "#block"
                },
                {
                    "include": "#selectors"
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#declaration"
                }
            ]
        },
        "declaration": {
            "begin": "([A-Za-z_][\\w-]*)\\s*(:)(?![\\w-]+[^;{}]*\\{)",
            "beginCaptures": {
                "1": {
                    "name": "support.type.property-name.bark"
                },
                "2": {
                    "name": "punctuation.separator.key-value.bark"
                }
            },
            "end": "(;)|(?=\\})",
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.bark"
                }
            },
            "patterns": [
                {
                    "include": "#values"
                }
            ]
        },
        "selectors": {
            "patterns": [
                {
                    "name": "entity.other.attribute-name.id.bark",
                    "match": "#[A-Za-z_][\\w-]*"
                },
                {
                    "name": "entity.other.attribute-name.class.bark",
                    "match": "\\.[A-Za-z_][\\w-]*"
                },
                {
                    "match": "(:)([A-Za-z][\\w-]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.entity.bark"
                        },
                        "2": {
                            "name": "entity.other.attribute-name.pseudo-class.bark"
                        }
                    }
                },
                {
                    "name": "entity.name.tag.bark",
                    "match": "\\b[A-Za-z_][\\w-]*\\b"
                },
                {
                    "name": "keyword.operator.combinator.bark",
                    "match": ">|&|\\*"
                },
                {
                    "name": "punctuation.separator.list.bark",
                    "match": ","
                }
            ]
        },
        "values": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "name": "constant.other.color.rgb-value.bark",
                    "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\\b"
                },
                {
                    "match": "(?<![\\w-])([+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?)(%|[A-Za-z]+)?",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.bark"
                        },
                        "2": {
                            "name": "keyword.other.unit.bark"
                        }
                    }
                },
                {
                    "begin": "([A-Za-z_][\\w-]*)(\\()",
                    "beginCaptures": {
                        "1": {
                            "name": "support.function.bark"
                        },
                        "2": {
                            "name": "punctuation.section.function.begin.bark"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.function.end.bark"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#values"
                        },
                        {
                            "name": "punctuation.separator.list.bark",
                            "match": ","
                        }
                    ]
                },
                {
                    "name": "variable.other.bark",
                    "match": "\\$[A-Za-z_][\\w-]*"
                },
                {
                    "name": "keyword.other.important.bark",
                    "match": "!\\s*important\\b"
                },
                {
                    "name": "support.constant.color.bark",
                    "match": "\\b(?:transparent|black|white|red|green|lime|blue|yellow|cyan|magenta|orange|purple|pink|brown|gray|grey|silver|navy|teal|maroon|olive|walnut)\\b"
                },
                {
                    "name": "support.constant.property-value.bark",
                    "match": "\\b[A-Za-z_][\\w-]*\\b"
                },
                {
                    "name": "punctuation.separator.list.bark",
                    "match": ","
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.bark",
                    "begin": "\"",
                    "end": "\"|$",
                    "patterns": [
                        {
                            "name": "constant.character.escape.bark",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.bark",
                    "begin": "'",
                    "end": "'|$",
                    "patterns": [
                        {
                            "name": "constant.character.escape.bark",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "declaration-dq": {
            "begin": "([A-Za-z_][\\w-]*)\\s*(:)",
            "beginCaptures": {
                "1": {
                    "name": "support.type.property-name.bark"
                },
                "2": {
                    "name": "punctuation.separator.key-value.bark"
                }
            },
            "end": "(;)|(?=\\})|(?=\\\")",
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.bark"
                }
            },
            "patterns": [
                {
                    "include": "#values"
                }
            ]
        },
        "declarations-dq": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#declaration-dq"
                }
            ]
        },
        "declaration-sq": {
            "begin": "([A-Za-z_][\\w-]*)\\s*(:)",
            "beginCaptures": {
                "1": {
                    "name": "support.type.property-name.bark"
                },
                "2": {
                    "name": "punctuation.separator.key-value.bark"
                }
            },
            "end": "(;)|(?=\\})|(?=')",
            "endCaptures": {
                "1": {
                    "name": "punctuation.terminator.bark"
                }
            },
            "patterns": [
                {
                    "include": "#values"
                }
            ]
        },
        "declarations-sq": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#declaration-sq"
                }
            ]
        }
    }
}
