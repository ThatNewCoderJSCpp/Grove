extern "C++" from "<grove/dom.hpp>" {
    class NativeElement as "grove::Element" {
    public:
        operator(==) function(const NativeElement&: other) const -> bool;
        function exists() const -> bool;
        function tag() const -> string;
        function id() const -> string;
        function has_attribute(const string&: name) const -> bool;
        function get_attribute(const string&: name) const -> string;
        function set_attribute(const string&: name, const string&: value) -> void;
        function remove_attribute(const string&: name) -> void;
        function inner_text() const -> string;
        function set_inner_text(const string&: value) -> void;
        function has_class(const string&: name) const -> bool;
        function add_class(const string&: name) -> void;
        function remove_class(const string&: name) -> void;
        function toggle_class(const string&: name) -> bool;
        function style(const string&: property) const -> string;
        function set_style(const string&: property, const string&: value) -> void;
        function remove_style(const string&: property) -> void;
        function computed_style(const string&: property) const -> string;
        function has_computed_style(const string&: property) const -> bool;
        function computed_number(const string&: property, short float: fallback) const -> short float;
        function computed_number_at(const string&: property, long int: index, short float: fallback) const -> short float;
        function computed_color(const string&: property) const -> string;
        function computed_bool(const string&: property, bool: fallback) const -> bool;
        function parent() const -> NativeElement;
        function child_count() const -> long int;
        function child(long int: index) const -> NativeElement;
        function index() const -> long int;
        function next_sibling() const -> NativeElement;
        function previous_sibling() const -> NativeElement;
        function append_child(const NativeElement&: child) -> bool;
        function insert_before(const NativeElement&: child, const NativeElement&: reference) -> bool;
        function remove() -> bool;
        function is_attached() const -> bool;
        function query(const string&: selector) const -> NativeElement;
        function listen(const string&: type, function() -> void: fn) -> long int;
        function remove_event_listener(long int: id) -> bool;
        function dispatch(const string&: type) -> bool;
        function focus() -> bool;
        function hovered() const -> bool;
        function focused() const -> bool;
        function active() const -> bool;
        function input_kind() const -> long int;
        function value_integer() const -> long int;
        function value_float() const -> short float;
        function value_bool() const -> bool;
        function value_string() const -> string;
        function value_text() const -> string;
        function value_color() const -> string;
        function set_value_integer(long int: value) -> bool;
        function set_value_float(short float: value) -> bool;
        function set_value_bool(bool: value) -> bool;
        function set_value_string(const string&: value) -> bool;
        function set_value_color(const string&: hex) -> bool;
        function window() const -> NativeElement;
        function open() -> bool;
        function close() -> bool;
        function is_open() const -> bool;
        function window_width() const -> short float;
        function window_height() const -> short float;
        function resize_window(short float: width, short float: height) -> bool;
        function move_window(short float: x, short float: y) -> bool;
        function focus_window() -> bool;
        function answer(bool: ok) -> bool;
        function answer_value() const -> string;
        function show_page() -> bool;
        function open_modal() -> bool;
        function close_modal() -> bool;
        function is_current() const -> bool;
    } end class NativeElement

    class NativeElementList as "grove::ElementList" {
    public:
        static function children_of(const NativeElement&: element) -> NativeElementList;
        static function query_all_in(const NativeElement&: element, const string&: selector) -> NativeElementList;
        function size() const -> long int;
        function empty() const -> bool;
        function at(long int: index) const -> NativeElement;
        function first() const -> NativeElement;
        function last() const -> NativeElement;
    } end class NativeElementList

    class NativeEvent as "grove::Event" {
    public:
        static function current() -> NativeEvent;
        function exists() const -> bool;
        function type() const -> string;
        function target() const -> NativeElement;
        function current_target() const -> NativeElement;
        function x() const -> short float;
        function y() const -> short float;
        function delta_x() const -> short float;
        function delta_y() const -> short float;
        function button() const -> long int;
        function key() const -> string;
        function input_text() const -> string as "text";
        function shift() const -> bool;
        function ctrl() const -> bool;
        function alt() const -> bool;
        function meta() const -> bool;
        function stop_propagation() -> void;
        function prevent_default() -> void;
        function default_prevented() const -> bool;
    } end class NativeEvent

    class NativeDocument as "grove::Document" {
    public:
        function root() const -> NativeElement;
        function body() const -> NativeElement;
        function get_by_id(const string&: id) const -> NativeElement;
        function get_by_class(const string&: name) const -> NativeElementList;
        function get_by_tag(const string&: tag) const -> NativeElementList;
        function id_selector(const string&: id) const -> NativeElement;
        function class_selector(const string&: name) const -> NativeElementList;
        function tag_selector(const string&: tag) const -> NativeElementList;
        function query(const string&: selector) const -> NativeElement;
        function query_all(const string&: selector) const -> NativeElementList;
        function create_element(const string&: tag) const -> NativeElement;
        function choice(const string&: group) const -> string;
        function set_choice(const string&: group, const string&: value) const -> bool;
        function listen(const string&: type, function() -> void: fn) const -> long int;
        function remove_event_listener(long int: id) const -> bool;
        function dispatch(const string&: type) const -> bool;
        function set_timeout(short float: milliseconds, function() -> void: fn) const -> long int;
        function set_interval(short float: milliseconds, function() -> void: fn) const -> long int;
        function clear_timer(long int: id) const -> bool;
        function main_window() const -> NativeElement;
        function has_native(const string&: name) const -> bool;
        function call(const string&: name, const string&: argument) const -> string;
        function choose_file(const string&: mode, const string&: title, const string&: filter) const -> string;
        function navigate(const string&: target) const -> bool;
        function go_back() const -> bool;
        function popup(const string&: kind, const string&: title, const string&: message, const string&: input, const string&: value, const string&: options) const -> NativeElement;
        function popup_info(const string&: title, const string&: message) const -> NativeElement;
        function popup_warning(const string&: title, const string&: message) const -> NativeElement;
        function popup_error(const string&: title, const string&: message) const -> NativeElement;
        function alert(const string&: message) const -> NativeElement;
        function warning(const string&: message) const -> NativeElement;
        function error(const string&: message) const -> NativeElement;
        function confirm(const string&: title, const string&: message, function(bool) -> void: fn) const -> NativeElement;
        function prompt_string(const string&: title, const string&: message, const string&: value, function(string) -> void: fn) const -> NativeElement;
        function prompt_integer(const string&: title, const string&: message, long int: value, function(long int) -> void: fn) const -> NativeElement;
        function prompt_float(const string&: title, const string&: message, short float: value, function(short float) -> void: fn) const -> NativeElement;
        function prompt_bool(const string&: title, const string&: message, bool: value, function(bool) -> void: fn) const -> NativeElement;
        function prompt_color(const string&: title, const string&: message, const string&: value, function(string) -> void: fn) const -> NativeElement;
        function prompt_choice(const string&: title, const string&: message, const string&: options, const string&: value, function(string) -> void: fn) const -> NativeElement;
        function prompt_slider(const string&: title, const string&: message, short float: value, short float: min, short float: max, function(short float) -> void: fn) const -> NativeElement;
        function time_ms() const -> short float;
        function width() const -> short float;
        function height() const -> short float;
        function quit() const -> void;
        function log(const string&: message) const -> void;
    } end class NativeDocument
} end extern

extern "C++" from "<grove/bark_api.hpp>" {
    class BarkValues as "grove::BarkValues" {
    public:
        constructor();
        function set(const string&: name, const string&: value) -> void;
        function set_default(const string&: name, const string&: value) -> void;
        function has(const string&: name) const -> bool;
        function get(const string&: name) const -> string;
        function get_or(const string&: name, const string&: fallback) const -> string;
        function erase(const string&: name) -> void;
        function provide(const string&: name, function() -> string: fn) -> void;
        function set_parent(const BarkValues&: parent) -> void;
        function count() const -> long int;
        function name_at(long int: index) const -> string;
        function interpolate(const string&: source) const -> string;
        function unknown_count(const string&: source) const -> long int;
        function unknown_at(const string&: source, long int: index) const -> string;
        static function escape_braces(const string&: source) -> string;
    } end class BarkValues

    class BarkFile as "grove::BarkFile" {
    public:
        constructor();
        static function parse(const string&: source, const string&: path) -> BarkFile;
        static function load(const string&: path) -> BarkFile;
        function loaded() const -> bool;
        function ok() const -> bool;
        function error_count() const -> long int;
        function error_at(long int: index) const -> string;
        function rule_count() const -> long int;
        function rule_name(long int: rule) const -> string;
        function find_rule(const string&: name) const -> long int;
        function has_rule(const string&: name) const -> bool;
        function property_count(long int: rule) const -> long int;
        function property_name(long int: rule, long int: property) const -> string;
        function property_line(long int: rule, long int: property) const -> long int;
        function property_text(long int: rule, long int: property) const -> string;
        function value_count(long int: rule, long int: property) const -> long int;
        function value_at(long int: rule, long int: property, long int: index) const -> string;
        function has_setting(long int: rule, const string&: name) const -> bool;
        function setting(long int: rule, const string&: name) const -> string;
        function setting_with(long int: rule, const string&: name, const BarkValues&: values) const -> string;
        function variable_count() const -> long int;
        function variable_name(long int: index) const -> string;
        function variable_value(long int: index) const -> string;
        function add_variables_to(BarkValues&: values) const -> void;
    } end class BarkFile

    class BarkCall as "grove::BarkCall" {
    public:
        static function current() -> BarkCall;
        function exists() const -> bool;
        function name() const -> string;
        function arg_count() const -> long int;
        function arg(long int: index) const -> string;
        function arg_or(long int: index, const string&: fallback) const -> string;
        function rest(long int: first) const -> string;
        function line() const -> long int;
        function values() const -> BarkValues;
        function next() const -> void;
        function wait() const -> void;
        function stop() const -> void;
        function fail(const string&: message) const -> void;
    } end class BarkCall

    class BarkActions as "grove::BarkActions" {
    public:
        constructor();
        function add_simple(const string&: name, long int: min_values, long int: max_values, bool: raw, function() -> void: fn) -> void;

        function add(const string&: name, function(BarkCall&) -> void: fn) -> void {
            add_simple(name, 0, -1, false, [fn]() -> void {
                BarkCall: call = BarkCall::current();
                fn(call);
            });
        } end function add

        function add_counted(const string&: name, long int: min_values, long int: max_values, function(BarkCall&) -> void: fn) -> void {
            add_simple(name, min_values, max_values, false, [fn]() -> void {
                BarkCall: call = BarkCall::current();
                fn(call);
            });
        } end function add_counted

        function add_raw(const string&: name, long int: min_values, long int: max_values, function(BarkCall&) -> void: fn) -> void {
            add_simple(name, min_values, max_values, true, [fn]() -> void {
                BarkCall: call = BarkCall::current();
                fn(call);
            });
        } end function add_raw

        function setting(const string&: name) -> void;
        function setting_counted(const string&: name, long int: min_values, long int: max_values) -> void as "setting";
        function add_standard() -> void;
        function has(const string&: name) const -> bool;
        function remove(const string&: name) -> bool;
        function check_count(const BarkFile&: file, long int: rule) const -> long int;
        function check_at(const BarkFile&: file, long int: rule, long int: index) const -> string;
    } end class BarkActions

    class BarkRunner as "grove::BarkRunner" {
    public:
        constructor(const BarkActions&: actions, const BarkFile&: file, const string&: rule);
        constructor(const BarkActions&: actions, const BarkFile&: file, const string&: rule, const BarkValues&: parent);
        function exists() const -> bool;
        function run() -> long int;
        function step() -> long int;
        function resume() -> long int;
        function answer(const string&: name, const string&: value) -> long int;
        function stop() -> void;
        function state() const -> long int;
        function waiting() const -> bool;
        function done() const -> bool;
        function stopped() const -> bool;
        function failed() const -> bool;
        function finished() const -> bool;
        function error() const -> string;
        function position() const -> long int;
        function size() const -> long int;
        function values() const -> BarkValues;
    } end class BarkRunner

} end extern

class Element;
class ElementList;
class Event;

class Element {
public:
    NativeElement: raw;

    function exists() const -> bool {
        return raw.exists();
    } end function exists

    function tag() const -> string {
        return raw.tag();
    } end function tag

    function id() const -> string {
        return raw.id();
    } end function id

    function has_attribute(const string&: name) const -> bool {
        return raw.has_attribute(name);
    } end function has_attribute

    function get_attribute(const string&: name) const -> string {
        return raw.get_attribute(name);
    } end function get_attribute

    function set_attribute(const string&: name, const string&: value) -> void {
        raw.set_attribute(name, value);
    } end function set_attribute

    function remove_attribute(const string&: name) -> void {
        raw.remove_attribute(name);
    } end function remove_attribute

    function inner_text() const -> string {
        return raw.inner_text();
    } end function inner_text

    function set_inner_text(const string&: value) -> void {
        raw.set_inner_text(value);
    } end function set_inner_text

    function has_class(const string&: name) const -> bool {
        return raw.has_class(name);
    } end function has_class

    function add_class(const string&: name) -> void {
        raw.add_class(name);
    } end function add_class

    function remove_class(const string&: name) -> void {
        raw.remove_class(name);
    } end function remove_class

    function toggle_class(const string&: name) -> bool {
        return raw.toggle_class(name);
    } end function toggle_class

    function style(const string&: property) const -> string {
        return raw.style(property);
    } end function style

    function set_style(const string&: property, const string&: value) -> void {
        raw.set_style(property, value);
    } end function set_style

    function remove_style(const string&: property) -> void {
        raw.remove_style(property);
    } end function remove_style

    function computed_style(const string&: property) const -> string {
        return raw.computed_style(property);
    } end function computed_style

    function has_computed_style(const string&: property) const -> bool {
        return raw.has_computed_style(property);
    } end function has_computed_style

    function computed_number(const string&: property) const -> short float {
        return raw.computed_number(property, 0.0);
    } end function computed_number

    function computed_number(const string&: property, short float: fallback) const -> short float {
        return raw.computed_number(property, fallback);
    } end function computed_number

    function computed_number_at(const string&: property, long int: index, short float: fallback) const -> short float {
        return raw.computed_number_at(property, index, fallback);
    } end function computed_number_at

    function computed_color(const string&: property) const -> string {
        return raw.computed_color(property);
    } end function computed_color

    function computed_bool(const string&: property) const -> bool {
        return raw.computed_bool(property, false);
    } end function computed_bool

    function computed_bool(const string&: property, bool: fallback) const -> bool {
        return raw.computed_bool(property, fallback);
    } end function computed_bool

    function parent() const -> Element {
        Element: out;
        out.raw = raw.parent();
        return out;
    } end function parent

    function child_count() const -> long int {
        return raw.child_count();
    } end function child_count

    function child(long int: index) const -> Element {
        Element: out;
        out.raw = raw.child(index);
        return out;
    } end function child

    function index() const -> long int {
        return raw.index();
    } end function index

    function next_sibling() const -> Element {
        Element: out;
        out.raw = raw.next_sibling();
        return out;
    } end function next_sibling

    function previous_sibling() const -> Element {
        Element: out;
        out.raw = raw.previous_sibling();
        return out;
    } end function previous_sibling

    function append_child(const Element&: child) -> bool {
        return raw.append_child(child.raw);
    } end function append_child

    function insert_before(const Element&: child, const Element&: reference) -> bool {
        return raw.insert_before(child.raw, reference.raw);
    } end function insert_before

    function remove() -> bool {
        return raw.remove();
    } end function remove

    function is_attached() const -> bool {
        return raw.is_attached();
    } end function is_attached

    function query(const string&: selector) const -> Element {
        Element: out;
        out.raw = raw.query(selector);
        return out;
    } end function query

    function listen(const string&: type, function() -> void: fn) -> long int {
        return raw.listen(type, fn);
    } end function listen

    function remove_event_listener(long int: id) -> bool {
        return raw.remove_event_listener(id);
    } end function remove_event_listener

    function dispatch(const string&: type) -> bool {
        return raw.dispatch(type);
    } end function dispatch

    function focus() -> bool {
        return raw.focus();
    } end function focus

    function hovered() const -> bool {
        return raw.hovered();
    } end function hovered

    function focused() const -> bool {
        return raw.focused();
    } end function focused

    function active() const -> bool {
        return raw.active();
    } end function active

    function input_kind() const -> long int {
        return raw.input_kind();
    } end function input_kind

    function value_integer() const -> long int {
        return raw.value_integer();
    } end function value_integer

    function value_float() const -> short float {
        return raw.value_float();
    } end function value_float

    function value_bool() const -> bool {
        return raw.value_bool();
    } end function value_bool

    function value_string() const -> string {
        return raw.value_string();
    } end function value_string

    function value_text() const -> string {
        return raw.value_text();
    } end function value_text

    function value_color() const -> string {
        return raw.value_color();
    } end function value_color

    function set_value_integer(long int: value) -> bool {
        return raw.set_value_integer(value);
    } end function set_value_integer

    function set_value_float(short float: value) -> bool {
        return raw.set_value_float(value);
    } end function set_value_float

    function set_value_bool(bool: value) -> bool {
        return raw.set_value_bool(value);
    } end function set_value_bool

    function set_value_string(const string&: value) -> bool {
        return raw.set_value_string(value);
    } end function set_value_string

    function set_value_color(const string&: hex) -> bool {
        return raw.set_value_color(hex);
    } end function set_value_color

    function window() const -> Element {
        Element: out;
        out.raw = raw.window();
        return out;
    } end function window

    function open() -> bool {
        return raw.open();
    } end function open

    function close() -> bool {
        return raw.close();
    } end function close

    function is_open() const -> bool {
        return raw.is_open();
    } end function is_open

    function window_width() const -> short float {
        return raw.window_width();
    } end function window_width

    function window_height() const -> short float {
        return raw.window_height();
    } end function window_height

    function resize_window(short float: width, short float: height) -> bool {
        return raw.resize_window(width, height);
    } end function resize_window

    function move_window(short float: x, short float: y) -> bool {
        return raw.move_window(x, y);
    } end function move_window

    function focus_window() -> bool {
        return raw.focus_window();
    } end function focus_window

    function answer(bool: ok) -> bool {
        return raw.answer(ok);
    } end function answer

    function answer_value() const -> string {
        return raw.answer_value();
    } end function answer_value

    function show_page() -> bool {
        return raw.show_page();
    } end function show_page

    function open_modal() -> bool {
        return raw.open_modal();
    } end function open_modal

    function close_modal() -> bool {
        return raw.close_modal();
    } end function close_modal

    function is_current() const -> bool {
        return raw.is_current();
    } end function is_current

    function children() const -> ElementList {
        ElementList: out;
        out.raw = NativeElementList::children_of(raw);
        return out;
    } end function children

    function query_all(const string&: selector) const -> ElementList {
        ElementList: out;
        out.raw = NativeElementList::query_all_in(raw, selector);
        return out;
    } end function query_all

    function add_event_listener(const string&: type, function(Event&) -> void: fn) -> long int {
        return raw.listen(type, [fn]() -> void {
            Event: e = Event::current();
            fn(e);
        });
    } end function add_event_listener

    function on(const string&: type, function(Event&) -> void: fn) -> long int {
        return add_event_listener(type, fn);
    } end function on

    operator(==) function(const Element&: other) const -> bool {
        return raw == other.raw;
    }
} end class Element

class ElementList {
public:
    NativeElementList: raw;

    function size() const -> long int {
        return raw.size();
    } end function size

    function empty() const -> bool {
        return raw.empty();
    } end function empty

    function at(long int: index) const -> Element {
