class Document {
public:
    NativeDocument: raw;

    function root() const -> Element {
        Element: out;
        out.raw = raw.root();
        return out;
    } end function root

    function body() const -> Element {
        Element: out;
        out.raw = raw.body();
        return out;
    } end function body

    function get_by_id(const string&: id) const -> Element {
        Element: out;
        out.raw = raw.get_by_id(id);
        return out;
    } end function get_by_id

    function get_by_class(const string&: name) const -> ElementList {
        ElementList: out;
        out.raw = raw.get_by_class(name);
