<grove>
    <head>
        <title>Grove editor demo</title>
        <style src="editor.bark" />
        <script lang="walnut" src="editor.wal"></script>
    </head>
    <body icon="../../Tools/icons/grove-16.png ../../Tools/icons/grove-32.png ../../Tools/icons/grove-256.png" app-id="grove-editor-demo">
        <row id="layout">
            <column id="side">
                <row class="brand">
                    <img src="../../Tools/icons/grove-64.png" width="28" />
                    <text class="heading">FILES</text>
                </row>
                <input_file id="folder" mode="folder">Open folder…</input_file>
                <list id="files">
                    <item><text>app.wal</text></item>
                    <item><img src="../../Tools/icons/grove-32.png" width="16" /><text>ui.grove</text></item>
                    <item><img src="../../Tools/icons/bark-32.png" width="16" /><text>theme.bark</text></item>
                    <item><text>notes.txt</text></item>
                </list>
            </column>
            <column id="main">
                <p class="intro">This paragraph is long enough to wrap onto several lines. It mixes <b>bold</b>, <i>italic</i>, <u>underlined</u> and <code>inline_code()</code> spans, plus a <link id="docs">link you can click</link>, all flowing on the same lines as the text around them.</p>
                <input_code id="code" language="cpp">
                    #include <iostream>

                    // A tiny program
                    int main() {
                        const char* name = "Grove";
                        for (int i = 0; i < 3; ++i) {
                            std::cout << "Hello, " << name << " #" << i << '\n';
                        }
                        return 0;
                    }
                </input_code>
                <pre id="log">$ grove run editor.grove
built 0 scripts
ready</pre>
            </column>
        </row>
    </body>
</grove>
