<grove>
    <head>
        <title>Grove to-do</title>
        <style src="todo.bark" />
        <script lang="walnut" src="todo.wal"></script>
        <script lang="c++" src="stats.cpp"></script>
    </head>
    <body>
        <h2>Things to do</h2>
        <row class="add">
            <input_string id="new-task" placeholder="Something to do, then Enter" maxlength="60" />
            <button id="add">Add</button>
        </row>
        <panel id="tasks"></panel>
        <row class="footer">
            <p id="stats">No tasks yet</p>
            <button id="clear-done">Clear done</button>
        </row>
        <p id="clock" class="muted">Open for 0 s</p>
    </body>
</grove>
