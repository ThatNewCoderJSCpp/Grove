$background = #1e1e2e;
$surface = #313244;
$text = #cdd6f4;
$muted = #9399b2;
$green = #a6e3a1;

body {
    size: 560px 520px;
    background: $background;
    color: $text;
    accent-color: $green;
    font-size: 15px;
    padding: 24px;
}

h2 {
    margin: 0 0 14px 0;
}

row.add {
    margin: 0 0 14px 0;

    input_string {
        width: 380px;
        margin: 0;
    }
}

#tasks {
    margin: 0 0 12px 0;
}

row.task {
    background: $surface;
    border-radius: 8px;
    padding: 8px 10px;
    margin: 0 0 6px 0;

    &:hover {
        background: #3b3d52;
    }

    &.done input_bool {
        color: $muted;
    }

    input_bool {
        margin: 0;
    }

    button {
        margin: 0;
        padding: 2px 10px;
    }
}

row.footer p {
    color: $muted;
    margin: 6px 0 0 0;
}

.muted {
    color: $muted;
    font-size: 12px;
}
