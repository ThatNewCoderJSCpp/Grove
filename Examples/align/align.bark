body {
    size: 940px 520px;
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 8px 20px;
}

h2 {
    font-size: 16px;
    margin: 8px 0;
}

.grid {
    gap: 16px;
}

.demo {
    width: 210px;
    align: top center;
}

.cell {
    width: 100%;
    height: 140px;
    margin: 0 0 6px 0;
    background: #313244;
    border-radius: 8px;
}

.box {
    width: 56px;
    height: 34px;
    background: #89b4fa;
    border-radius: 6px;
}

.tall {
    height: 80px;
}

.bar {
    height: 18px;
    margin: 0 0 8px 0;
    background: #a6e3a1;
    border-radius: 4px;
}

code {
    font-size: 12px;
    color: #9399b2;
}
