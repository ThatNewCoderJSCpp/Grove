<!grove>
<grove>
    <head>
        <title>Notes - Settings</title>
        <style>
            .setting { gap: 12px; }
        </style>
    </head>
    <body>
        <h2>Settings</h2>
        <input_bool id="dark" checked switch>Dark mode</input_bool>
        <row class="setting">
            <text>Accent</text>
            <input_color id="accent" value="#89b4fa" />
        </row>
        <link to="home">Back to Home</link>
    </body>
</grove>
